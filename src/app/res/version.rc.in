// Generated by CMake from version.rc.in: the version comes from git tags.
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SPELLBOOK_VERSION_MAJOR@,@SPELLBOOK_VERSION_MINOR@,@SPELLBOOK_VERSION_PATCH@,@SPELLBOOK_FILE_BUILD@
 PRODUCTVERSION @SPELLBOOK_VERSION_MAJOR@,@SPELLBOOK_VERSION_MINOR@,@SPELLBOOK_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rizonesoft"
            VALUE "FileDescription", "Spellbook, your grimoire of AI prompts"
            VALUE "FileVersion", "@SPELLBOOK_VERSION@"
            VALUE "InternalName", "Spellbook"
            VALUE "LegalCopyright", "Copyright (C) 2026 Rizonetech (Pty) Ltd. MIT License."
            VALUE "OriginalFilename", "Spellbook.exe"
            VALUE "ProductName", "Spellbook"
            VALUE "ProductVersion", "@SPELLBOOK_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
